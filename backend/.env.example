# Database Configuration (Required)
# Use PostgreSQL 12+. Create database and user first.
DATABASE_URL=postgresql://user:password@localhost:5432/legaltrack

# Server Configuration
PORT=4000
NODE_ENV=development

# CORS (Frontend URL - comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# Email Configuration (Optional - for hearing reminders)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@legaltrack.dev

# Background Job Schedules (Cron format)
# Daily case ingestion at 00:30 UTC (06:00 IST)
CRON_SCHEDULE=30 0 * * *

# Hearing reminders at 02:30 UTC (08:00 IST)
NOTIF_SCHEDULE=30 2 * * *

# Feature Flags
ENABLE_PDF_EXTRACTION=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_BACKGROUND_FETCH=true

# Logging
LOG_LEVEL=info
